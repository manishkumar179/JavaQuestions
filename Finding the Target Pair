function twoSum(nums, target) {
    const map = new Map(); // Numbes aur unke index ko store karne ke liye
    
    for (let i = 0; i < nums.length; i++) {
        let complement = target - nums[i];
        
        // Agar complement pehle se map mein hai, toh answer mil gaya
        if (map.has(complement)) {
            return [map.get(complement), i];
        }
        
        // Warna current number ko map mein save kar lo
        map.set(nums[i], i);
    }
    return [];
}
