class Solution {
    public int[] sortedSquares(int[] nums) {
       int n=nums.length; 
       int pos=n-1;
       int st=0; 
       int end=n-1; 
       int []ans = new int[n];
       for(int i=n-1; i>=0; i--){
        if(Math.abs(nums[st])>Math.abs(nums[end])){
            ans[pos--]=nums[st]*nums[st];
            st++;
        }else{
            ans[pos--]=nums[end]*nums[end];
            end--;
        }
       }
       return ans;
    }
}
